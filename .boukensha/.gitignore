# Runtime logs. Written on every run, append-only, reproducible only by playing —
# they bury real changes in the diff. Ignored in git, still kept on disk.
*.log

# Per-profile append-only jsonl log streams (one file per day / per session).
profiles/*/sessions/
profiles/*/journal/
profiles/*/manager/
profiles/*/telnet/

# The map each test case ended with, named after its session. One binary per
# case, pruned to the 30 most recent per profile — kept on disk so a past run's
# memory can be reopened, never committed, because they churn on every run and
# are reproducible only by running.
#
# `tests/knowledge/snapshots/` is deliberately NOT ignored: a pinned fixture is
# the one memory artifact that belongs in git, and the whole point of promoting
# a retained map is that the result is reviewable and stays put.
tests/knowledge/sessions/
